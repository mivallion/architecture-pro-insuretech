<mxCell id="policy-write" value="Одна транзакция" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=0;fontColor=#33445A;strokeColor=#61758B;strokeWidth=1.5;endArrow=blockThin;endFill=1;labelBackgroundColor=#FFFFFF;spacing=5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="core" target="coredb"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-15" as="offset"/></mxGeometry></mxCell>
<mxCell id="policy-read" value="Чтение outbox" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=0;fontColor=#33445A;strokeColor=#61758B;strokeWidth=1.5;endArrow=blockThin;endFill=1;labelBackgroundColor=#FFFFFF;spacing=5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="coredb" target="pubpolicy"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-15" as="offset"/></mxGeometry></mxCell>
<mxCell id="policy-send" value="Публикация" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=0;fontColor=#33445A;strokeColor=#7865AA;strokeWidth=2;endArrow=blockThin;endFill=1;labelBackgroundColor=#FFFFFF;spacing=5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="pubpolicy" target="kpolicy"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-20" as="offset"/></mxGeometry></mxCell>
<mxCell id="dedup" value="&lt;b&gt;Доставка допускает повторы&lt;/b&gt;&lt;br&gt;Получатель сохраняет event_id вместе с изменением своей БД.&lt;br&gt;Повторное событие с тем же event_id пропускается." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontStyle=0;fontColor=#182B43;spacing=12;rounded=1;arcSize=6;align=left;verticalAlign=top;fillColor=#FFF8E7;strokeColor=#D2BB83;spacing=18;" vertex="1" parent="1"><mxGeometry x="90" y="880" width="820" height="110" as="geometry"/></mxCell>
<mxCell id="ack" value="&lt;b&gt;Когда удалять запись из outbox&lt;/b&gt;&lt;br&gt;Только после подтверждения Kafka. Сбой до отметки об отправке&lt;br&gt;приведёт к повторной публикации, а не к пропуску события." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontStyle=0;fontColor=#182B43;spacing=12;rounded=1;arcSize=6;align=left;verticalAlign=top;fillColor=#FFF8E7;strokeColor=#D2BB83;spacing=18;" vertex="1" parent="1"><mxGeometry x="1000" y="880" width="910" height="110" as="geometry"/></mxCell>
<mxCell id="settlement" value="&lt;b&gt;ins-comp-settlement&lt;/b&gt;&lt;br&gt;[Контейнер: Kotlin / Spring Boot]&lt;br&gt;Читает полисы и каталог" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontStyle=0;fontColor=#182B43;spacing=12;rounded=1;arcSize=8;fillColor=#EAF2FC;strokeColor=#668CB9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="90" y="1140" width="300" height="130" as="geometry"/></mxCell>
<mxCell id="settlementdb" value="&lt;b&gt;settlement-db&lt;/b&gt;&lt;br&gt;[PostgreSQL]&lt;br&gt;Реестр, каталог, event_id" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontStyle=0;fontColor=#182B43;spacing=12;shape=cylinder3;size=15;boundedLbl=1;backgroundOutline=1;fillColor=#EDF7F3;strokeColor=#599582;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="580" y="1140" width="320" height="130" as="geometry"/></mxCell>
<mxCell id="client" value="&lt;b&gt;client-info&lt;/b&gt;&lt;br&gt;[Контейнер: Kotlin / Spring Boot]&lt;br&gt;Управляет данными клиента" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontStyle=0;fontColor=#182B43;spacing=12;rounded=1;arcSize=8;fillColor=#EAF2FC;strokeColor=#668CB9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1050" y="1140" width="300" height="130" as="geometry"/></mxCell>
<mxCell id="clientdb" value="&lt;b&gt;client-info-db&lt;/b&gt;&lt;br&gt;[PostgreSQL]&lt;br&gt;Данные клиента" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontStyle=0;fontColor=#182B43;spacing=12;shape=cylinder3;size=15;boundedLbl=1;backgroundOutline=1;fillColor=#EDF7F3;strokeColor=#599582;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1550" y="1140" width="320" height="130" as="geometry"/></mxCell>
<mxCell id="settlement-write" value="SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=0;fontColor=#33445A;strokeColor=#61758B;strokeWidth=1.5;endArrow=blockThin;endFill=1;labelBackgroundColor=#FFFFFF;spacing=5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="settlement" target="settlementdb"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-15" as="offset"/></mxGeometry></mxCell>
<mxCell id="client-write" value="SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=0;fontColor=#33445A;strokeColor=#61758B;strokeWidth=1.5;endArrow=blockThin;endFill=1;labelBackgroundColor=#FFFFFF;spacing=5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="client" target="clientdb"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-15" as="offset"/></mxGeometry></mxCell>
<mxCell id="recovery" value="&lt;b&gt;Ошибки и восстановление&lt;/b&gt;&lt;br&gt;Повторные попытки, затем DLQ и уведомление.&lt;br&gt;Контролируем задержку потребителей и возраст outbox.&lt;br&gt;Для восстановления копии: согласованный снимок + события." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontStyle=0;fontColor=#182B43;spacing=12;rounded=1;arcSize=6;align=left;verticalAlign=top;fillColor=#FFF8E7;strokeColor=#D2BB83;spacing=18;" vertex="1" parent="1"><mxGeometry x="90" y="1350" width="860" height="160" as="geometry"/></mxCell>
<mxCell id="schedule" value="&lt;b&gt;Реестр без ночной выгрузки&lt;/b&gt;&lt;br&gt;Полисы поступают в settlement по мере оформления.&lt;br&gt;Расчёт агентских премий и отправка реестра страховщикам&lt;br&gt;выполняются раз в месяц." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontStyle=0;fontColor=#182B43;spacing=12;rounded=1;arcSize=6;align=left;verticalAlign=top;fillColor=#FFF8E7;strokeColor=#D2BB83;spacing=18;" vertex="1" parent="1"><mxGeometry x="1020" y="1350" width="890" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>
