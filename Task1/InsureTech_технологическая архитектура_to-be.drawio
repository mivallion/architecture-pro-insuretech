<mxCell id="dcs1" value="&lt;b&gt;etcd 1&lt;/b&gt;&lt;br&gt;Регион 1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontStyle=0;fontColor=#182B43;spacing=12;rounded=1;arcSize=8;fillColor=#ECEBFA;strokeColor=#8075B2;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="110" y="930" width="370" height="100" as="geometry"/></mxCell>
<mxCell id="dcs3" value="&lt;b&gt;etcd 3&lt;/b&gt;&lt;br&gt;Независимая третья площадка" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontStyle=0;fontColor=#182B43;spacing=12;rounded=1;arcSize=8;fillColor=#ECEBFA;strokeColor=#8075B2;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="845" y="930" width="410" height="100" as="geometry"/></mxCell>
<mxCell id="dcs2" value="&lt;b&gt;etcd 2&lt;/b&gt;&lt;br&gt;Регион 2" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontStyle=0;fontColor=#182B43;spacing=12;rounded=1;arcSize=8;fillColor=#ECEBFA;strokeColor=#8075B2;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1580" y="930" width="370" height="100" as="geometry"/></mxCell>
<mxCell id="quorum1" value="Кворум: 2 из 3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=0;fontColor=#33445A;strokeColor=#7865AA;strokeWidth=2;endArrow=blockThin;endFill=1;labelBackgroundColor=#FFFFFF;spacing=5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="dcs1" target="dcs3"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-18" as="offset"/></mxGeometry></mxCell>
<mxCell id="quorum2" value="Кворум: 2 из 3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=0;fontColor=#33445A;strokeColor=#7865AA;strokeWidth=2;endArrow=blockThin;endFill=1;labelBackgroundColor=#FFFFFF;spacing=5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="dcs3" target="dcs2"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-18" as="offset"/></mxGeometry></mxCell>
<mxCell id="dcs-note" value="Все узлы Patroni используют этот DCS; региональные прокси проверяют роль и отставание реплик." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontStyle=0;fontColor=#182B43;spacing=12;text;align=center;" vertex="1" parent="1"><mxGeometry x="90" y="1060" width="1900" height="40" as="geometry"/></mxCell>
<mxCell id="backup" value="&lt;b&gt;Объектное хранилище&lt;/b&gt;&lt;br&gt;Вне основного региона&lt;br&gt;Ежедневная полная копия + архив WAL&lt;br&gt;Восстановление на момент времени (PITR)" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontStyle=0;fontColor=#182B43;spacing=12;shape=cylinder3;size=15;boundedLbl=1;backgroundOutline=1;fillColor=#EDF7F3;strokeColor=#599582;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70" y="1180" width="550" height="170" as="geometry"/></mxCell>
<mxCell id="backup-note" value="&lt;b&gt;Резервные копии&lt;/b&gt;&lt;br&gt;Текущий primary передаёт резервные копии и WAL в объектное хранилище.&lt;br&gt;Контролируем возраст последней копии и архива WAL; регулярно проверяем восстановление.&lt;br&gt;Репликация не защищает от ошибочного удаления данных — для этого нужен PITR." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontStyle=0;fontColor=#182B43;spacing=12;rounded=1;arcSize=6;align=left;verticalAlign=top;fillColor=#FFF8E7;strokeColor=#D2BB83;spacing=18;" vertex="1" parent="1"><mxGeometry x="745" y="1180" width="1280" height="170" as="geometry"/></mxCell>
<mxCell id="failover" value="&lt;b&gt;Переключение БД&lt;/b&gt;&lt;br&gt;Patroni управляет выбором primary.&lt;br&gt;При потере региона проверяем отставание DR-реплики, изолируем старый primary и повышаем реплику.&lt;br&gt;Прокси переключает RW endpoint.&lt;br&gt;Не допускаем одновременно два узла записи." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontStyle=0;fontColor=#182B43;spacing=12;rounded=1;arcSize=6;align=left;verticalAlign=top;fillColor=#FFF8E7;strokeColor=#D2BB83;spacing=18;" vertex="1" parent="1"><mxGeometry x="70" y="1420" width="610" height="255" as="geometry"/></mxCell>
<mxCell id="rpo" value="&lt;b&gt;RPO и RTO — проверяемые цели&lt;/b&gt;&lt;br&gt;Мониторим отставание реплик и ставим порог предупреждения ниже 15 минут.&lt;br&gt;При разрыве канала требование RPO требует ограничить запись до превышения бюджета потери данных.&lt;br&gt;Весь сценарий восстановления — до 45 минут." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontStyle=0;fontColor=#182B43;spacing=12;rounded=1;arcSize=6;align=left;verticalAlign=top;fillColor=#FFF8E7;strokeColor=#D2BB83;spacing=18;" vertex="1" parent="1"><mxGeometry x="745" y="1420" width="610" height="255" as="geometry"/></mxCell>
<mxCell id="sharding" value="&lt;b&gt;Шардирование не требуется&lt;/b&gt;&lt;br&gt;Объём данных — 50 GB.&lt;br&gt;Разделение на шарды пока добавит больше сложности, чем пользы.&lt;br&gt;Начинаем с ресурсов primary, индексов и реплик чтения. Чтения, требующие свежих данных, направляем на primary." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontStyle=0;fontColor=#182B43;spacing=12;rounded=1;arcSize=6;align=left;verticalAlign=top;fillColor=#FFF8E7;strokeColor=#D2BB83;spacing=18;" vertex="1" parent="1"><mxGeometry x="1415" y="1420" width="610" height="255" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>
